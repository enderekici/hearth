# Compose publishes to loopback by default. Use a trusted LAN interface address only when needed.
HEARTH_BIND_ADDRESS=127.0.0.1
HEARTH_ALLOWED_HOSTS=127.0.0.1,localhost

# Host paths mounted into the container. Keep personal photos and app data outside Git.
HEARTH_DATA_DIR=./data
HEARTH_PHOTO_DIR=./photos
